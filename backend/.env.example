# Talent Bridge API. Copy to backend/.env and fill in what you use; everything is optional.
# Every value here stays on the server. Never put real secrets in the frontend or in git.

# Supabase Postgres (Project Settings > Database > Connection string). Either the direct
# connection (port 5432) or the pooler (port 6543) works. Replace [YOUR-PASSWORD] including the
# brackets. Leave empty to use a local SQLite file (backend/talent_bridge.db) with no setup.
DATABASE_URL=

# Supabase Auth: https://<project-ref>.supabase.co. Access tokens are verified with the project's
# public signing keys, so sign-in needs no secret. SUPABASE_JWKS_URL defaults to
# $SUPABASE_URL/auth/v1/.well-known/jwks.json; set it only to override that.
SUPABASE_URL=
SUPABASE_JWKS_URL=
# Only for inviting Ashby applicants to the candidate portal (Supabase Admin API). The secret or
# service role key: keep it here, never in the frontend or git. SUPABASE_SERVICE_ROLE_KEY works too.
SUPABASE_SECRET_KEY=
# Invite Ashby applicants to the candidate portal at the email they applied with.
PORTAL_INVITES_ENABLED=true

# Load the demo pipeline into an empty database on startup. Set false in production.
SEED_DEMO_DATA=true
ENVIRONMENT=development

# AI: mock (offline, default), gemini or groq. Without the matching key, mock is used.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Speech to text for the AI Assistant's voice input (Groq only; otherwise the browser's own recognition).
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Ashby (optional; the app works without it). The key needs candidatesRead, jobsRead and
# interviewsRead. The webhook secret is the one entered in Ashby for the webhook.
ASHBY_API_KEY=
ASHBY_WEBHOOK_SECRET=
# AI analysis of each application Ashby submits, in the background.
ASHBY_AUTO_ANALYZE=true
# The reconciliation sync invites applicants it finds only if they applied this recently.
ASHBY_SYNC_INVITE_MAX_AGE_DAYS=14
# Custom Ashby stage titles to Talent Bridge stages (sourced, screening, interview, offer, hired), as JSON.
ASHBY_STAGE_TITLE_MAP={}
# Development only: demo jobs and the public /demo/careers site (see the README). Ignored in production.
# ENABLE_ASHBY_DEMO=false

# CORS: the frontend's origin. CORS_ORIGINS takes a comma-separated list of extra origins.
FRONTEND_URL=http://localhost:3000
