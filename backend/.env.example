# Talent Bridge API. Copy to backend/.env and fill in what you use; everything is optional.
# Every value here stays on the server. Never put real secrets in the frontend or in git.

# Supabase Postgres (Project Settings > Database > Connection string). Either the direct
# connection (port 5432) or the pooler (port 6543) works. Leave empty to use a local SQLite
# file (backend/talent_bridge.db) with no setup.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Load the demo pipeline into an empty database on startup. Set false in production.
SEED_DEMO_DATA=true
ENVIRONMENT=development

# AI: mock (offline, default), gemini or groq. Without the matching key, mock is used.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ashby (optional; the app works without it)
ASHBY_API_KEY=
ASHBY_WEBHOOK_SECRET=

# CORS: the frontend's origin. CORS_ORIGINS takes a comma-separated list of extra origins.
FRONTEND_URL=http://localhost:3000

# Requests act as this recruiter until Supabase Auth is added.
DEFAULT_USER_EMAIL=alex.chen@encord.example
