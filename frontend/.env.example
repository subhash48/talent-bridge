# Talent Bridge frontend. Copy to frontend/.env.local.
# Only NEXT_PUBLIC_ values reach the browser, and they must be safe to publish: never put the Supabase
# secret or service role key, a database password or any API key here.

# The FastAPI backend (a bare origin like http://localhost:8000 works too).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Auth (Project Settings > API): the project URL and its publishable key (sb_publishable_...),
# both public by design. Used for signing in only; all data goes through the API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# true: use seeded in-browser demo data instead of the API (frontend-only development, no sign-in).
NEXT_PUBLIC_USE_MOCK_API=false
