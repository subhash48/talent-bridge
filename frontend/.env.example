# Talent Bridge recruiter workspace. Copy to frontend/.env.local.
# Only NEXT_PUBLIC_ values reach the browser: never put API keys or Supabase secrets here.

# The FastAPI backend (a bare origin like http://localhost:8000 works too).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# true: use seeded in-browser demo data instead of the API (frontend-only development).
NEXT_PUBLIC_USE_MOCK_API=false
